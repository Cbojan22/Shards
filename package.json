{
  "name": "shards",
  "version": "1.4.0",
  "description": "Shards — AI-powered long-form video to viral short-form clip generator with a retro TUI",
  "type": "module",
  "main": "dist/tui/index.js",
  "bin": {
    "shards": "dist/tui/index.js",
    "shards-cli": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli/index.js dist/tui/index.js",
    "dev": "tsx src/tui/index.tsx",
    "start": "node dist/tui/index.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "shards": "tsx src/tui/index.tsx",
    "shards-cli": "tsx src/cli/index.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ora": "^8.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
